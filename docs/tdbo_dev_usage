# permitir ejecución para tdbo.sh
chmod +x ./tdbo.sh

# crear un alias para usar tdbo como un programa con bash
sudo ln -s "$(pwd)/tdbo.sh" /usr/local/bin/tdbo

# Ejemplo de uso:
# tdbo { install <USUARIO_DB> <CONTRASEÑA_DB> | rebuild | up | down | pgadmin { up | down } }

tdbo install mydbuser mydbpassword # instala dependencias y configura los ajustes básicos del archivo .env. IMPORTANTE: esto no reemplaza otros campos como JWT_SECRET o la configuración inicial de la cuenta Admin. DEBES configurar esos campos previamente.
tdbo rebuild # reconstruye desde cero los contenedores Docker para pruebas de desarrollo.
tdbo up # inicia docker compose sin recrear contenedores
tdbo down # detiene docker compose
tdbo pgadmin up # crea el contenedor de pgAdmin y abre el navegador una vez que esté listo
tdbo pgadmin down # detiene el contenedor de pgAdmin.